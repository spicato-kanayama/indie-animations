---
// layouts
import BaseLayout from '@layouts/BaseLayout.astro';

type PostProps = {
	slug: string;
	title: string;
	fonts?: string[];
};

type PostModule = {
	default: any;
	props: PostProps;
};

export function getStaticPaths() {
	const postModules = import.meta.glob<PostModule>('../posts/*.astro', {
		eager: true,
	});

	return Object.values(postModules).map((mod) => ({
		params: {
			slug: mod.props.slug,
		},
		props: {
			post: mod.props,
			PostComponent: mod.default,
		},
	}));
}

const { post, PostComponent } = Astro.props as {
	post: PostProps;
	PostComponent: any;
};

const pageProps = {
	slug: post.slug,
	title: post.title,
};

const fonts = post.fonts ?? [];
---

<BaseLayout {...pageProps}>
	<Fragment slot="before-close-head">
		{
			fonts.map((href) => (
				<Fragment>
					<link rel="preload" as="style" href={href} />
					<link
						rel="stylesheet"
						href={href}
						media="print"
						onload="this.media='all'"
					/>
				</Fragment>
			))
		}
	</Fragment>

	<div class="pSingle">
		<div class="pSingle__inner">
			<div class="pSingle__back">
				<a href="/" class="pSingle__back_link">
					<div class="pSingle__back_icon">
						<svg role="img" aria-hidden="true">
							<use href="/assets/images/common/symbol.svg#arrow"
							></use>
						</svg>
					</div>

					<div class="pSingle__back_text">Back</div>
				</a>
			</div>

			<div class="pSingle__contents">
				<PostComponent />
			</div>
		</div>
	</div>
</BaseLayout>
