---
export const props = {
	slug: 'squash-stretch',
	title: 'Squash and Stretch',
	createdAt: '7/25/2026, 3:57:02 PM',
};
---

<c-squash-stretch id="squash-stretch" class="js-single">
	<h1 class="uVisuallyHidden">Squash and Stretch</h1>

	<div class="squash-stretch">
		<div class="squash-stretch__circle"></div>
	</div>
</c-squash-stretch>

<script>
	import { ComponentElement } from '../assets/js/stores/componentManager';

	let interval: any = null;

	class SquashStretch extends HTMLElement {
		constructor() {
			super();
		}

		connectedCallback() {
			const singleClone = this.cloneNode(true);

			// 3秒ごとにクローンを挿入し、既存の要素を削除する
			interval = setInterval(() => {
				const parent = this.parentNode;

				this.remove();

				// firstSingle の後に singleClone を挿入する
				parent?.insertBefore(
					singleClone.cloneNode(true),
					this.nextSibling
				);
			}, 4000);
		}

		disconnectedCallback() {
			if (interval) {
				clearInterval(interval);
			}
		}
	}

	customElements.define(
		'c-squash-stretch',
		ComponentElement(SquashStretch, 'c-squash-stretch')
	);
</script>

