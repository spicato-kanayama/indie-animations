---
export const props = {
	slug: 'nothing',
	title: 'Nothing',
	createdAt: '8/8/2026, 5:28:29 PM',
	fonts: [
		'https://fonts.googleapis.com/css2?family=Doto:wght@100..900&display=swap',
	],
};
---

<c-nothing id="nothing" class="js-single">
	<h1 class="uVisuallyHidden">Nothing</h1>

	<div class="pNothing">
		<div class="pNothing__stage">
			<div class="pNothing__text">Nothing</div>

			<p class="pNothing__paragraph">
				I'm a big fan of Nothing products.
			</p>

			<div class="pNothing__center">
				<div class="pNothing__center_circle" data-circle="1"></div>
				<div class="pNothing__center_circle" data-circle="2"></div>
				<div class="pNothing__center_circle" data-circle="3"></div>
			</div>

			<div class="pNothing__red"></div>

			<div class="pNothing__gray"></div>

			<div class="pNothing__black">
				<div class="pNothing__black_circle" data-circle="1"></div>
				<div class="pNothing__black_circle" data-circle="2"></div>
				<div class="pNothing__black_circle" data-circle="3"></div>
				<div class="pNothing__black_circle" data-circle="4"></div>
			</div>

			<div class="pNothing__hole" data-hole="1"></div>
			<div class="pNothing__hole" data-hole="2"></div>
		</div>
	</div>
</c-nothing>

<script>
	import { ComponentElement } from '../assets/js/stores/componentManager';

	let interval: any = null;

	class Nothing extends HTMLElement {
		constructor() {
			super();
		}

		connectedCallback() {
			const singleClone = this.cloneNode(true);

			// 3秒ごとにクローンを挿入し、既存の要素を削除する
			// interval = setInterval(() => {
			// 	const parent = this.parentNode;

			// 	this.remove();

			// 	// firstSingle の後に singleClone を挿入する
			// 	parent?.insertBefore(
			// 		singleClone.cloneNode(true),
			// 		this.nextSibling
			// 	);
			// }, 4000);
		}

		disconnectedCallback() {
			if (interval) {
				clearInterval(interval);
			}
		}
	}

	customElements.define('c-nothing', ComponentElement(Nothing, 'c-nothing'));
</script>

<style lang="scss" is:global>
	@use '/src/assets/scss/global' as *;

	#nothing {
		grid-column: 4 / -4;
	}

	.pNothing {
		container-type: inline-size;

		&__stage {
			position: relative;
			display: flex;
			align-items: center;
			justify-content: center;
			width: 100%;
			aspect-ratio: 1 / 1.414;
			padding: 6cqw 4cqw;
			background-color: var(--color-white);
		}

		&__text {
			margin-top: auto;
			font-family: Doto, sans-serif;
			font-size: 18cqw;
			font-weight: 900;
			line-height: 1;
			color: var(--color-black-2);
			letter-spacing: -0.05em;
		}

		&__paragraph {
			position: absolute;
			top: 29%;
			left: 24%;
			font-family: Doto, sans-serif;
			font-size: 3.4cqw;
			font-weight: 700;
			line-height: 1;
			color: var(--color-black-2);
			letter-spacing: -0.03em;
			writing-mode: vertical-rl;
		}

		&__center {
			position: absolute;
			top: 20%;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: space-around;
			width: 40cqw;
			height: 80cqw;
			background-color: var(--color-white);
			border: 1px solid #a3a3a3;
			border-radius: 8px;
			box-shadow:
				inset 2px 2px 2px #e3e3e3,
				inset -2px -2px 2px #e3e3e3;

			&_circle {
				&[data-circle='1'],
				&[data-circle='2'] {
					position: relative;
					z-index: 1;
					width: 32cqw;
					height: 32cqw;
					background-color: #c8c8c8;
					border: 1px solid #5c5c5c;
					border-radius: 50%;
					box-shadow:
						inset 2px 2px 3px #e3e3e3,
						inset -2px -2px 3px #e3e3e3;

					&::before {
						position: absolute;
						top: 0;
						left: 0;
						z-index: -1;
						width: 100%;
						height: 100%;
						content: '';
						border-radius: 50%;
						box-shadow:
							2px 2px 2px #0000003f,
							-2px -2px 2px #0000003f;
					}
				}

				&[data-circle='3'] {
					position: absolute;
					left: 10cqw;
					width: 3px;
					height: 3px;
					margin-top: 2cqw;
					background-color: var(--color-black-1);
					border-radius: 50%;
				}
			}
		}

		&__red {
			position: absolute;
			top: 33%;
			left: 0;
			width: 10cqw;
			height: 10cqw;
			background-color: #ec0e0e;
		}

		&__gray {
			position: absolute;
			top: 0;
			right: 16%;
			z-index: 1;
			width: 10cqw;
			height: 14cqw;
			background-color: #c8c8c8;
			border-right: 1px solid #5c5c5c;
			border-bottom: 1px solid #5c5c5c;
			border-left: 1px solid #5c5c5c;
			border-radius: 0 0 50vh 50vh;
			box-shadow:
				inset 2px 2px 3px #e3e3e3,
				inset -2px -2px 3px #e3e3e3;

			&::before {
				position: absolute;
				top: 0;
				left: 0;
				z-index: -1;
				width: 100%;
				height: 100%;
				content: '';
				border-radius: 0 0 50vh 50vh;
				box-shadow:
					2px 2px 2px #0000003f,
					-2px -2px 2px #0000003f;
			}
		}

		&__black {
			position: absolute;
			top: 33%;
			right: 0;
			width: 20cqw;
			height: 40cqw;

			&_circle {
				position: absolute;
				width: 4px;
				height: 4px;
				background-color: var(--color-black-1);
				border-radius: 50%;

				&[data-circle='1'] {
					top: 30%;
					right: 30%;
				}

				&[data-circle='2'] {
					top: 40%;
					right: 30%;
				}

				&[data-circle='3'] {
					top: 60%;
					right: 30%;
				}

				&[data-circle='4'] {
					top: 60%;
					right: 50%;
				}
			}
		}

		&__hole {
			position: absolute;
			width: 8cqw;
			height: 8cqw;
			background: linear-gradient(145deg, #a2a2a2, #eee);
			border-radius: 50%;
			box-shadow:
				inset 0.8cqw 0.8cqw 0.4cqw #a2a2a2,
				inset -0.4cqw -0.4cqw 0.2cqw #a2a2a2;

			&[data-hole='1'] {
				top: 6%;
				left: 10%;
			}

			&[data-hole='2'] {
				top: 6%;
				left: 22%;
			}
		}
	}

	.pHome {
		& #nothing {
			grid-column: 6 / -6;
		}
	}

	@include pc {
		#nothing {
			grid-column: 8 / -8;
		}

		.pHome {
			& #nothing {
				grid-column: 4 / -4;
			}
		}
	}
</style>
